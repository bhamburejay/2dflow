set pm3d map 
set size square
set multiplot layout 2,2 title "Simple Hydrodynamics Energy Density"

# Plots the enenergy density at various times

set xlabel "x (fm)"
set ylabel "y (fm)"
set zlabel "Energy Density (1/fm^4)"

# c is backwards y x ... 
# t=1.0 fm/c
splot "simple_output.txt" using 2:1:3 index 0 
# t=3.0 fm/c
splot "simple_output.txt" using 2:1:3 index 3 
# t=6.0 fm/c
splot "simple_output.txt" using 2:1:3 index 6 
# t=9.0 fm/c
splot "simple_output.txt" using 2:1:3 index 9 